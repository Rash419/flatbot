# Required: the token @BotFather gave you for your bot.
TELEGRAM_BOT_TOKEN=

# Base URL the phones use to reach this server from outside, e.g. https://bot.example.net (no trailing slash needed).
PUBLIC_URL=

# Port the webhook listens on inside the container; to expose a different port, change the left side of "ports" in docker-compose.yml instead.
PORT=8080

# Where the SQLite database lives; the container already uses /data/bot.db, which is ./data on the host.
# DB_PATH=/data/bot.db

# Currency code shown in messages.
CURRENCY=INR

# Time zone used for dates in history and exports.
TIMEZONE=Asia/Kolkata

# Model Codex uses for reading SMS, emails and bills; leave empty for Codex's default.
CODEX_MODEL=

# Reasoning effort per AI call (minimal, low, medium, high, xhigh); low keeps calls quick and light on usage.
CODEX_EFFORT=low

# Seconds to wait for one AI call before giving up (the bot retries the SMS later).
AI_TIMEOUT=120

# Comma-separated words matched against the From address of order emails; only these are read. Empty means the built-in list.
MAIL_SENDERS=swiggy,zomato,blinkit,zepto,bigbasket,amazon,flipkart,instamart,dunzo,dmart,jiomart,licious,countrydelight,eatsure,dominos,magicpin

# Seconds between mailbox checks (minimum 30).
MAIL_POLL_SECONDS=120

# Telegram Bot API base URL; only change it if you run your own Bot API server.
TELEGRAM_API_BASE=https://api.telegram.org
